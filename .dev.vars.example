# Copy to .dev.vars for local development (gitignored). In production set each with
# `wrangler secret put NAME`. Empty = feature disabled; the admin fails closed.

# "development" turns on the local admin bypass below; anything else is production.
ENVIRONMENT=development

# Local only: lets you open /admin without Cloudflare Access. Never set in production.
ADMIN_DEV_BYPASS=true

# Password login for /admin (the default). Generate the hash with:
#   npm run admin:password -- 'your-password'
# and set both values as secrets. Without BOTH, password login stays off.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional, stronger alternative: Cloudflare Access (Zero Trust). The team domain is
# <team>.cloudflareaccess.com and the AUD is the application's Audience tag; both appear in
# the Access application's settings. When configured, a valid Access token is accepted too.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Only this Google identity may use the admin (checked against the Access JWT email claim).
ADMIN_EMAIL=

# Google Apps Script web-app URL that appends contact-form rows to a Google Sheet.
CONTACT_WEBHOOK_URL=
# Shared token checked by Apps Script; never exposed to visitors.
CONTACT_WEBHOOK_SECRET=

# Optional: ping a private Telegram chat on each contact message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
