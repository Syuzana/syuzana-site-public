# Copy to .dev.vars for local development (gitignored). In production set each with
# `wrangler secret put NAME`. Empty = feature disabled; the admin fails closed.

# "development" turns on the local admin bypass below; anything else is production.
ENVIRONMENT=development

# Local only: lets you open /admin without Cloudflare Access. Never set in production.
ADMIN_DEV_BYPASS=true

# Cloudflare Access (Zero Trust) — the team domain is <team>.cloudflareaccess.com,
# the AUD is the application's Audience tag. Both are shown in the Access app settings.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Only this Google identity may use the admin (checked against the Access JWT email claim).
ADMIN_EMAIL=

# Google Apps Script web-app URL that appends contact-form rows to a Google Sheet.
CONTACT_WEBHOOK_URL=

# Optional: ping a private Telegram chat on each contact message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
